filters:
  or:
    - file.path.containsAny("ACT")
    - file.path.contains("+/kb_output")
formulas:
  Created: file.ctime.relative()
  Paper: if((file.properties.annotated == false),link(file,"🟥 " + file.name),link(file,"🟩 " + file.name))
  PDF: if(file("+/pdf/" + file.name + ".pdf").path.contains(".pdf"),link("+/pdf/" + file.name + ".pdf","🟢 PDF"),link(file.properties.doi,"🟡 Web"))
  "": file.properties.conn == this.file.name
  Updated: file.mtime.relative()
properties:
  note.annotated:
    displayName: Annotated
  note.geared:
    displayName: 🏋️‍♀️
  note.conn:
    displayName: Connection
  note.title:
    displayName: zettel term
  formula.:
    displayName: papers
  file.name:
    displayName: Title
  note.status:
    displayName: 🏋️‍♀️
  note.authors:
    displayName: Author
  note.origin_source:
    displayName: Source
views:
  - type: table
    name: Status Overview
    order:
      - file.folder
      - annotated
      - geared
      - status
    sort:
      - property: file.folder
        direction: ASC
      - property: annotated
        direction: ASC
      - property: geared
        direction: ASC
    columnSize:
      file.folder: 120
      file.name: 200
      note.annotated: 80
      note.geared: 60
      note.status: 60
    rowHeight: compact
  - type: table
    name: Annotations
    filters:
      and:
        - file.folder.contains("0️⃣Annotation")
        - '!file.folder.contains("cards")'
    order:
      - formula.Paper
      - annotated
      - geared
      - formula.Created
      - formula.PDF
      - title
    sort:
      - property: formula.Created
        direction: DESC
      - property: annotated
        direction: ASC
      - property: title
        direction: ASC
      - property: conn
        direction: DESC
    limit: 10
    columnSize:
      formula.Paper: 150
      note.annotated: 60
      note.geared: 47
      formula.Created: 73
      note.title: 964
    rowHeight: medium
  - type: table
    name: Connections
    filters:
      and:
        - file.tags.contains("concept/conn")
    order:
      - file.name
      - thought
    sort:
      - property: formula.
        direction: ASC
      - property: conn
        direction: ASC
    rowHeight: tall
    columnSize:
      file.name: 212
  - type: table
    name: Thoughts
    filters:
      and:
        - file.hasTag("concept/thought")
    order:
      - file.name
      - origin_source
    limit: 10
    rowHeight: tall
    columnSize:
      file.name: 359
  - type: table
    name: Annotations dynamic
    filters:
      and:
        - file.hasLink(this.file)
        - file.hasTag("concept/anno")
    order:
      - formula.Paper
      - annotated
      - geared
      - formula.Created
      - formula.Updated
      - formula.PDF
    sort:
      - property: formula.Updated
        direction: DESC
      - property: formula.PDF
        direction: ASC
      - property: geared
        direction: ASC
    columnSize:
      formula.Paper: 184
      note.annotated: 84
      note.geared: 74
      formula.Created: 92
      formula.PDF: 92
  - type: table
    name: Connections dynamic
    filters:
      and:
        - file.hasLink(this.file)
        - file.hasTag("concept/conn")
    order:
      - file.name
      - status
      - thought
    sort:
      - property: formula.
        direction: ASC
      - property: conn
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 212
  - type: table
    name: Parent Annotations
    filters:
      and:
        - file.hasTag("concept/anno")
        - this.file.hasLink(file)
    order:
      - formula.Paper
      - annotated
      - geared
    sort:
      - property: geared
        direction: ASC
      - property: formula.Paper
        direction: DESC
    columnSize:
      formula.Paper: 200
      note.annotated: 84
      note.geared: 74
    rowHeight: medium
  - type: table
    name: Child Thoughts
    filters:
      and:
        - file.hasTag("concept/thought")
        - file.hasLink(this.file)
    order:
      - file.name
      - status
    sort:
      - property: file.name
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 280
      note.status: 80
  - type: table
    name: Thoughts dynamic
    filters:
      or:
        - and:
            - file.hasTag("concept/thought")
            - file.hasLink(this.file)
        - and:
            - file.hasLink(this.file)
            - file.folder.contains("cards")
    order:
      - file.name
      - origin_source
    sort:
      - property: origin_source
        direction: DESC
    rowHeight: medium
    columnSize:
      file.name: 289
  - type: table
    name: Source Cards dynamic
    filters:
      and:
        - this.file.hasLink(file)
        - file.folder.contains("cards")
    order:
      - file.name
      - title
    sort:
      - property: title
        direction: DESC
      - property: file.name
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 180
      note.title: 350
  - type: table
    name: Parent Connections
    filters:
      and:
        - file.hasTag("concept/conn")
        - this.file.hasLink(file)
    order:
      - file.name
      - status
    sort:
      - property: file.name
        direction: ASC
    rowHeight: medium
    columnSize:
      file.name: 300
      note.status: 100
  - type: table
    name: Forward Links
    filters:
      and:
        - this.file.hasLink(file)
        - '!file.hasLink("Atlas/Sources/Notes.base")'
    order:
      - file.name
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
    rowHeight: compact
    columnSize:
      file.name: 250
      file.folder: 150
  - type: table
    name: Related by Tags
    filters:
      and:
        - file.tags.any(tag => this.file.tags.includes(tag))
        - file.path != this.file.path
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC
    rowHeight: compact
    columnSize:
      file.name: 250
      file.tags: 200
  - type: table
    name: Last import
    filters:
      and:
        - file.folder.endsWith("kb_output")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
